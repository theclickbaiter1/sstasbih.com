---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shahid · MIT",
  description = "Shahid Tasbih - Aerospace Engineering student at MIT. Building autonomous machines and future spacecraft.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" id="favicon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="cursor-glow" id="cursorGlow"></div>
  <slot />
  <div class="lightbox" id="lightbox"></div>

  <script>
    // Tab attention: title + spinning away favicon when the user leaves
    const ACTIVE_TITLE = 'Shahid · MIT';
    const AWAY_TITLE = 'Hey - come back';
    const ACTIVE_ICON = '/favicon.svg';

    const favicon = document.getElementById('favicon') as HTMLLinkElement | null;
    let spinTimer: ReturnType<typeof setInterval> | null = null;
    let cycleTimer: ReturnType<typeof setTimeout> | null = null;
    let away = false;

    /** Black + purple mark; red badge fixed; S rotates for a 360 flip. */
    const awayIcon = (deg: number) => {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none">
  <rect width="32" height="32" rx="8" fill="#0b0b0f"/>
  <rect x="1" y="1" width="30" height="30" rx="7" stroke="#7c3aed" stroke-width="1.5" fill="none"/>
  <g transform="rotate(${deg} 16 16)">
    <text x="16" y="22" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="16" font-weight="700" fill="#c4b5fd">S</text>
  </g>
  <circle cx="25" cy="7" r="7" fill="#0b0b0f"/>
  <circle cx="25" cy="7" r="5.5" fill="#ef4444"/>
</svg>`;
      return `data:image/svg+xml,${encodeURIComponent(svg)}`;
    };

    const stopSpin = () => {
      if (spinTimer) clearInterval(spinTimer);
      if (cycleTimer) clearTimeout(cycleTimer);
      spinTimer = null;
      cycleTimer = null;
    };

    const runFlip = () => {
      if (!favicon || !away) return;
      let deg = 0;
      const step = 30;
      const frameMs = 50; // 12 frames * 50ms ≈ 0.6s per flip
      spinTimer = setInterval(() => {
        deg += step;
        if (favicon) favicon.href = awayIcon(deg);
        if (deg >= 360) {
          if (spinTimer) clearInterval(spinTimer);
          spinTimer = null;
          if (favicon) favicon.href = awayIcon(0);
          // Pause, then flip again
          cycleTimer = setTimeout(runFlip, 2500);
        }
      }, frameMs);
    };

    const setAway = () => {
      if (away) return;
      away = true;
      document.title = AWAY_TITLE;
      stopSpin();
      if (favicon) favicon.href = awayIcon(0);
      runFlip();
    };

    const setActive = () => {
      away = false;
      stopSpin();
      document.title = ACTIVE_TITLE;
      if (favicon) favicon.href = ACTIVE_ICON;
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) setAway();
      else setActive();
    });
    window.addEventListener('blur', setAway);
    window.addEventListener('focus', setActive);

    // Cursor glow
    const glow = document.getElementById('cursorGlow');
    let glowVisible = false;
    document.addEventListener('mousemove', (e) => {
      if (!glowVisible) { glow!.style.opacity = '1'; glowVisible = true; }
      glow!.style.left = e.clientX + 'px';
      glow!.style.top = e.clientY + 'px';
    });
    document.addEventListener('mouseleave', () => {
      glow!.style.opacity = '0';
      glowVisible = false;
    });

    // Tag click isolation
    document.querySelectorAll('a.tag').forEach((tag) => {
      tag.addEventListener('click', (e) => e.stopPropagation());
    });

    // Scroll reveal (respect reduced motion)
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
    }

    // Lightbox (images only; videos keep native controls)
    const lightbox = document.getElementById('lightbox');
    document.querySelectorAll('.card-media img, .story-media img, .media-frame img').forEach((img) => {
      (img as HTMLElement).style.cursor = 'zoom-in';
      img.addEventListener('click', () => {
        lightbox!.innerHTML = `<img src="${(img as HTMLImageElement).src}" alt="${(img as HTMLImageElement).alt}" />`;
        lightbox!.classList.add('active');
      });
    });
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        const vid = lightbox.querySelector('video');
        if (vid) vid.pause();
        lightbox.classList.remove('active');
        lightbox.innerHTML = '';
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
        lightbox.classList.remove('active');
        lightbox.innerHTML = '';
      }
    });
  </script>
</body>
</html>
