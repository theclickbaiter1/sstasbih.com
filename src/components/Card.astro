---
interface Props {
  period: string;
  title: string;
  description: string;
  tags: { label: string; href?: string }[];
  href?: string;
  /** Optional homepage thumbnail (e.g. /assets/projects/lunar-lander/thumb.jpg) */
  image?: string;
  imageAlt?: string;
  mediaPlaceholder?: boolean;
}

const {
  period,
  title,
  description,
  tags,
  href,
  image,
  imageAlt = title,
  mediaPlaceholder = false,
} = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class="card"
  {...href ? { href, target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div class="card-period">{period}</div>
  <div class="card-body">
    <h4 class="card-title">
      <span class="card-title-text">{title}</span>
      {href && (
        <svg class="card-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7" />
          <path d="M7 7h10v10" />
        </svg>
      )}
    </h4>
    <p class="card-description" set:html={description} />
    {image && (
      <div class="card-thumb reveal">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    )}
    {mediaPlaceholder && (
      <div class="card-media">
        <slot name="media">
          <div class="media-placeholder">Add images or videos to public/assets/ and update this section</div>
        </slot>
      </div>
    )}
    <div class="card-tags">
      {tags.map(tag => (
        tag.href ? (
          <a class="tag" href={tag.href} target="_blank" rel="noopener noreferrer">{tag.label}</a>
        ) : (
          <span class="tag">{tag.label}</span>
        )
      ))}
    </div>
  </div>
</Tag>
