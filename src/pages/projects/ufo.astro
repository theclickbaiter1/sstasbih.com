      alt="Acceleration comparison plot"
      caption="Outer frame ~10g pulse vs inner accelerometer ~1.64g sustained"
      aspect="16/9"
    />
    -->
  </section>

  <section class="story-section">
    <h2>Hard Part Next</h2>
    <p>
      Software can prove the control idea in sim. Hardware is the bottleneck: finding a motor
      that can dump enough rotational energy into the system quickly enough to track a real
      high-G event.
    </p>
  </section>
</ProjectLayout>
